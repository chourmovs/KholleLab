APP_ENV=development
POSTGRES_DB=khollelab
POSTGRES_USER=khollelab
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://khollelab:change-me@postgres:5432/khollelab
CORS_ORIGINS=http://localhost:3000
INTERNAL_API_URL=http://backend:8000
PROBLEMS_DIR=/problems

# Hugging Face Inference Providers (backend/worker only; never NEXT_PUBLIC_*)
LLM_PROVIDER=huggingface
HF_TOKEN=
LLM_MODEL_FAMILY=qwen
HF_QWEN_FAST_MODEL=Qwen/Qwen3-8B:nscale
HF_QWEN_DEEP_MODEL=Qwen/Qwen3-32B:nscale
HF_FAST_MAX_TOKENS=192
HF_EXAMINER_AUDIT_MAX_TOKENS=1024
HF_EXAMINER_ADJUDICATION_MAX_TOKENS=1536
HF_TIMEOUT_SECONDS=60
EVALUATION_WORKER_POLL_SECONDS=1
EVALUATION_STALE_SECONDS=180
LOG_LEVEL=INFO
LOG_ROTATION=10 MB
LOG_RETENTION=7 days
DIAGNOSTICS_ENABLED=false
# DIAGNOSTICS_TOKEN=generate-a-strong-random-secret
