APP_ENV=development
POSTGRES_DB=khollelab
POSTGRES_USER=khollelab
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://khollelab:change-me@postgres:5432/khollelab
CORS_ORIGINS=http://localhost:3000
INTERNAL_API_URL=http://backend:8000
PROBLEMS_DIR=/problems

# Local llama.cpp inference (backend-only; never NEXT_PUBLIC_*)
LLM_PROVIDER=local
LOCAL_LLM_BASE_URL=http://inference:8080/v1
LOCAL_LLM_MODEL=Qwen/Qwen3-4B-GGUF
LOCAL_LLM_HF_REPO=Qwen/Qwen3-4B-GGUF
LOCAL_LLM_QUANT=Q4_K_M
LOCAL_LLM_CONTEXT_SIZE=8192
LOCAL_LLM_THREADS=6
LOCAL_LLM_BATCH_SIZE=512
LOCAL_LLM_PARALLEL=1
LOCAL_LLM_TEMPERATURE=0.2
LOCAL_LLM_TOP_P=0.9
LOCAL_LLM_MAX_TOKENS=512
LOCAL_LLM_TIMEOUT_SECONDS=90
LOG_LEVEL=INFO
LOG_ROTATION=10 MB
LOG_RETENTION=7 days
DIAGNOSTICS_ENABLED=false
# DIAGNOSTICS_TOKEN=generate-a-strong-random-secret
# HF_TOKEN= (optional; only for gated repositories)
