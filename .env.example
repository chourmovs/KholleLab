APP_ENV=development
POSTGRES_DB=khollelab
POSTGRES_USER=khollelab
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://khollelab:change-me@postgres:5432/khollelab
CORS_ORIGINS=http://localhost:3000
# Server-side authentication (never expose these as NEXT_PUBLIC variables)
AUTH_SESSION_DAYS=30
AUTH_COOKIE_NAME=khollelab_session
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_SECONDS=300
INTERNAL_API_URL=http://backend:8000
PROBLEMS_DIR=/problems
RESOURCES_DIR=/resources
CURRICULUM_DIR=/curriculum
# Optional deterministic override, for example: CURRICULUM_ACADEMIC_YEAR=2026-2027

# Hugging Face Inference Providers (backend/worker only; never NEXT_PUBLIC_*)
LLM_PROVIDER=huggingface
HF_TOKEN=
LLM_MODEL_FAMILY=qwen
HF_QWEN_FAST_MODEL=Qwen/Qwen3-8B:nscale
HF_QWEN_DEEP_MODEL=Qwen/Qwen3-32B:nscale
HF_FAST_MAX_TOKENS=512
HF_FAST_RETRY_MAX_TOKENS=768
HF_EXAMINER_AUDIT_MAX_TOKENS=1024
HF_EXAMINER_ADJUDICATION_MAX_TOKENS=1536
HF_TIMEOUT_SECONDS=60
HF_REQUEST_MAX_ATTEMPTS=3
HF_RETRY_BASE_SECONDS=1
HF_RETRY_MAX_SECONDS=8
HF_RETRY_JITTER_SECONDS=0.5
EVALUATION_PROVIDER_MAX_RETRIES=4
EVALUATION_PROVIDER_RETRY_DELAYS_SECONDS=15,45,120,300
EVALUATION_WORKER_POLL_SECONDS=1
EVALUATION_STALE_SECONDS=180
EVALUATION_WORKER_HEARTBEAT_SECONDS=10
EVALUATION_WORKER_HEALTH_MAX_AGE_SECONDS=45
LOG_LEVEL=INFO
LOG_ROTATION=10 MB
LOG_RETENTION=7 days
DIAGNOSTICS_ENABLED=false
# DIAGNOSTICS_TOKEN=generate-a-strong-random-secret
# Colleur automatique (les valeurs ci-dessous sont les valeurs de production recommandées)
PROACTIVE_TUTOR_ENABLED=true
TUTOR_INITIAL_GRACE_SECONDS=45
TUTOR_IDLE_AFTER_CHANGE_SECONDS=6
TUTOR_MIN_ASSESSMENT_INTERVAL_SECONDS=25
TUTOR_INTERVENTION_COOLDOWN_SECONDS=45
TUTOR_STALLED_SECONDS=90
TUTOR_MAX_AUTO_ASSESSMENTS_PER_ATTEMPT=12
TUTOR_AUTO_MAX_HELP_LEVEL=3
TUTOR_RESOURCE_RECOMMENDATIONS_ENABLED=true
TUTOR_RESOURCE_AUTO_MIN_CONFIDENCE=0.90
TUTOR_RESOURCE_MANUAL_MIN_CONFIDENCE=0.85
# Demand-driven, globally reusable generated exercise catalogue
LLM_PROBLEM_GENERATION_ENABLED=false
LLM_PROBLEM_POOL_TARGET=8
LLM_PROBLEM_MAX_GENERATION_ATTEMPTS=3
LLM_PROBLEM_DIVERSITY_CONTEXT_LIMIT=8
LLM_PROBLEM_NEAR_DUPLICATE_THRESHOLD=0.88
LLM_PROBLEM_GENERATOR_FAMILY=qwen
LLM_PROBLEM_CRITIC_FAMILY=gemma
